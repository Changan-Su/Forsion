   {
    "id": "controls",
    "kind": "controls",
    "inputIds": [
     "kind",
     "order",
     "budget"
    ]
   },
   {
    "id": "list",
    "kind": "table",
    "columns": [
     "型号",
     "价格",
     "重量",
     "续航"
    ],
    "rows": "each(sorted, 'x', [x.name, format(x.price, 'number', 0), x.weight + ' kg', x.battery + ' h'])"
   }
  ]
 },
 "quiz": {
  "version": 2,
  "id": "quiz",
  "title": "常识小测",
  "inputs": [],
  "state": [
   {
    "id": "qs",
    "initial": [
     {
      "q": "光年是什么的单位？",
      "options": [
       "时间",
       "距离",
       "亮度"
      ],
      "answer": 1
     },
     {
      "q": "水在海平面沸腾的温度是？",
      "options": [
       "90 °C",
       "100 °C",
       "110 °C"
      ],
      "answer": 1
     },
     {
      "q": "地球绕太阳一圈大约要？",
      "options": [
       "一个月",
       "一年",
       "十年"
      ],
      "answer": 1
     }
    ]
   },
   {
    "id": "at",
    "initial": 0
   },
   {
    "id": "score",
    "initial": 0
   },
   {
    "id": "picked",
    "initial": null
   }
  ],
  "derived": [
   {
    "id": "total",
    "expr": "count(qs)"
   },
   {
    "id": "done",
    "expr": "at >= total"
   },
   {
    "id": "q",
    "expr": "done ? null : qs[at]"
   },
   {
    "id": "right",
    "expr": "picked != null and picked == q.answer"
   }
  ],
  "resources": [],
  "blocks": [
   {
    "id": "question",
    "kind": "text",
    "markdown": "**第 {{at + 1}} 题**：{{q.q}}",
    "when": {
     "expr": "not done"
    }
   },
   {
    "id": "answers",
    "kind": "actions",
    "when": {
     "expr": "not done and picked == null"
    },
    "items": [
     {
      "id": "a0",
      "kind": "set",
      "label": "A",
      "steps": [
       {
        "set": "picked",
        "to": "0"
       },
       {
        "set": "score",
        "to": "score + (q.answer == 0 ? 1 : 0)"
       }
      ]
     },
     {
      "id": "a1",
      "kind": "set",
      "label": "B",
      "steps": [
       {
        "set": "picked",
        "to": "1"
       },
       {
        "set": "score",
        "to": "score + (q.answer == 1 ? 1 : 0)"
       }
      ]
     },
     {
      "id": "a2",
      "kind": "set",
      "label": "C",
      "steps": [
       {
        "set": "picked",
        "to": "2"
       },
       {
        "set": "score",
        "to": "score + (q.answer == 2 ? 1 : 0)"
       }
      ]
     }
    ]
   },
   {
    "id": "feedback",
    "kind": "text",
    "markdown": "{{right ? '答对了。' : '不对，正确答案是 ' + q.options[q.answer] + '。'}}",
    "when": {
     "expr": "picked != null and not done"
    }
   },
   {
    "id": "options",
    "kind": "table",
    "columns": [
     "选项",
     "内容"
    ],
    "when": {
     "expr": "not done"
    },
    "rows": "each(range(0, count(q.options) - 1), 'k', [['A', 'B', 'C'][k], q.options[k]])"
   },
   {
    "id": "next",
    "kind": "actions",
    "when": {
     "expr": "picked != null and not done"
    },
    "items": [
     {
      "id": "go",
      "kind": "set",
      "label": "下一题",
      "steps": [
       {
        "set": "at",
        "to": "at + 1"
       },
       {
        "set": "picked",
        "to": "null"
       }
      ]
     }
    ]
   },
   {
    "id": "result",
    "kind": "text",
    "markdown": "测完了：{{score}} / {{total}} 题答对。",
    "when": {
     "expr": "done"
    }
   },
   {
    "id": "stats",
    "kind": "stats",
    "items": [
     {
      "label": "得分",
      "value": "score + ' / ' + total"
     },
     {
      "label": "进度",
      "value": "min(at, total) + ' / ' + total"
     }
    ]
   },
   {
    "id": "again",
    "kind": "actions",
    "when": {
     "expr": "done"
    },
    "items": [
     {
      "id": "restart",
      "kind": "set",
      "label": "再来一遍",
      "steps": [
       {
        "reset": "at"
       },
       {
        "reset": "score"
       },
       {
        "reset": "picked"
       }
      ]
     }
    ]
   }
  ]
 },
 "grades": {
