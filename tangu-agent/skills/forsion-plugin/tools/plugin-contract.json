  "classes": {
    ".btn": "Push button: neutral outline, accent on hover",
    ".btn.primary": "The one main action of a dialog or form (filled)",
    ".btn.ghost": "Quiet secondary action",
    ".btn.danger": "Destructive action",
    ".btn.sm": "Smaller button, for toolbars and dense rows",
    ".ctx-menu": "Menu shell (surface, border, shadow, padding). Its direct <button> children are the items; button.danger marks a destructive one",
    ".ctx-menu-scroll": "Inner wrapper of a .ctx-menu that scrolls when the menu is tall",
    ".ctx-separator": "Divider line between groups inside a .ctx-menu",
    ".ctx-shortcut": "Right-aligned shortcut / hint text inside a .ctx-menu item",
    ".ctx-head": "Small group heading inside a .ctx-menu",
    ".empty-state": "Centered empty / nothing-yet block",
    ".empty-title": "Title line inside .empty-state"
  },
