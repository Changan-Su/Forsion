{
  "name": "forsion-desktop",
  "version": "2.8.1",
  "description": "Forsion Desktop — AI 驱动的应用生态系统的桌面端(Electron):Tangu Agent 引擎 + LCL 可停靠工作区框架 + 可插拔功能空间(对话/笔记/日历/收件箱/编码),按产品档案裁出全家桶与单品发行版",
  "author": "Forsion",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "node build/link-lcl.cjs && node build/copy-excalidraw-assets.cjs && node build/fix-pty-helper.cjs",
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite frontend",
    "gallery": "echo '→ http://localhost:8100/lcl/gallery/' && python3 -m http.server 8100 --bind 127.0.0.1 --directory ..",
    "test": "vitest run",
    "e2e:editor": "node scripts/e2e-editor.cjs",
    "e2e:dnd": "node scripts/block-dnd.e2e.cjs",
    "e2e:ribbon": "node scripts/ribbon-dnd.e2e.cjs",
    "e2e:mindmap": "node scripts/mindmap.e2e.cjs",
    "e2e:canvas": "node scripts/canvas.e2e.cjs",
    "e2e:daily": "node scripts/daily-template.e2e.cjs",
    "e2e:plugview": "node scripts/plugin-view.e2e.cjs",
    "e2e:latex": "node scripts/e2e-editor.cjs --script=latex-suite.e2e.cjs",
    "e2e:recall": "node scripts/recall-rewind.e2e.cjs",
    "e2e:chatevents": "node scripts/chat-events.e2e.cjs",
    "e2e:chatshimmer": "node scripts/chat-shimmer.e2e.cjs",
    "e2e:planlive": "node scripts/plan-live.e2e.cjs",
    "check:pillbar": "node scripts/pillbar-overflow.check.cjs",
    "check:approval": "node scripts/approval-menu.check.cjs",
    "check:addmenu": "node scripts/add-menu.check.cjs",
    "check:caret": "node scripts/smooth-caret.check.cjs",
    "check:spacerestore": "node scripts/space-restore.check.cjs",
    "check:spacerestart": "node scripts/space-restart.check.cjs",
    "check:br": "node scripts/e2e-editor.cjs --check=blank-line-br",
    "check:caretmerge": "node scripts/e2e-editor.cjs --check=caret-merge",
    "check:canvascaret": "node scripts/e2e-editor.cjs --check=canvas-caret",
    "check:amadeusinteractions": "node scripts/e2e-editor.cjs --check=amadeus-interactions",
    "check:dashboard": "node scripts/e2e-editor.cjs --check=dashboard",
    "check:overlay": "node scripts/overlay-zoom.check.cjs",
    "check:leadicon": "node scripts/t2s-lead-icon.check.cjs",
    "check:tasksummary": "node scripts/task-summary.check.cjs",
    "check:plancard": "node scripts/plan-card.check.cjs",
    "check:searchrow": "node scripts/search-row.check.cjs",
    "check:diffmulti": "node scripts/diff-multifile.check.cjs",
    "check:railjank": "node scripts/rail-jank.check.cjs",
    "check:deskrail": "node scripts/desk-rail.check.cjs",
    "check:ctxring": "node scripts/ctxring-hover.check.cjs",
    "check:connect": "node scripts/connect-preview.check.cjs",
    "check:modelmenu": "node scripts/model-menu.check.cjs",
    "check:menutap": "node scripts/menu-tap.check.cjs",
    "check:settingsui": "node scripts/settings-ui.check.cjs",
    "check:marketui": "node scripts/market-ui.check.cjs",
    "check:uifont": "node scripts/ui-font.check.cjs",
    "check:topchrome": "node scripts/top-chrome.check.cjs",
    "check:minicard": "node scripts/mini-card.check.cjs",
    "check:board": "node scripts/board-paper.check.cjs",
    "check:boardlive": "node scripts/e2e-editor.cjs --check=board-live",
    "check:scrollbar": "node scripts/scrollbar-overlay.check.cjs",
    "check:callout": "node scripts/callout-fold.check.cjs",
    "check:srcbtn": "node scripts/source-toggle.check.cjs",
    "check:bsurface": "node scripts/e2e-editor.cjs --check=plugin-blocksurface",
    "pack": "electron-builder --config electron-builder.config.cjs --dir",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "fetch-python": "node build/fetch-python.cjs",
    "fetch-node": "node build/fetch-node.cjs",
    "typecheck": "tsc --noEmit && node ../tangu-agent/scripts/sync-command-catalog.mjs --check",
    "dev:amadeus": "FORSION_PRODUCT=amadeus electron-vite dev --noSandbox",
    "build:amadeus": "FORSION_PRODUCT=amadeus electron-vite build",
    "pack:amadeus": "FORSION_PRODUCT=amadeus npm run build:amadeus && FORSION_PRODUCT=amadeus electron-builder --config electron-builder.config.cjs --dir",
    "check:remount": "node scripts/main-remount.check.cjs",
    "check:nav": "node scripts/nav-history.check.cjs",
    "check:builtins": "node scripts/builtins.check.cjs",
    "check:suggest": "node scripts/suggest-chip.check.cjs",
    "check:hooks": "eslint --config build/eslint.hooks.mjs \"frontend/src/**/*.{ts,tsx}\"",
    "check:deskshot": "node scripts/desk-shot.check.cjs",
    "check:splash": "node scripts/splash-loop.check.cjs",
    "check:parity": "node scripts/platform-parity.check.cjs",
    "check:unitswitcher": "node scripts/unit-switcher.check.cjs",
    "test:ics-tz": "for tz in Europe/London America/New_York Asia/Shanghai Australia/Lord_Howe UTC; do echo \"== $tz\"; TZ=$tz vitest run frontend/src/views/calendar/ics.test.ts || exit 1; done",
    "check:arrowtrap": "node scripts/arrow-trap.check.cjs",
    "check:bsfocus": "node scripts/backspace-focus.check.cjs",
    "check:docs": "node scripts/docs-links.check.cjs",
    "check:menuclamp": "node scripts/menu-clamp.check.cjs",
    "check:capsule": "node scripts/mobile-capsule.check.cjs",
    "check:drawer": "node scripts/mobile-drawer.check.cjs",
    "check:uimode": "node scripts/uimode-auto.check.cjs",
    "check:focusring": "node scripts/focus-ring.check.cjs",
    "check:chatside": "node scripts/chat-sidepanel.check.cjs",
    "check:canvas": "node scripts/e2e-editor.cjs --check=unified-canvas",
    "check:canvasreal": "node scripts/e2e-editor.cjs --check=canvas-realinput",
    "check:canvastouch": "node scripts/e2e-editor.cjs --check=canvas-touch",
    "check:blockops": "node scripts/e2e-editor.cjs --check=block-file-ops",
    "check:quickfind": "node scripts/e2e-editor.cjs --check=quickfind-cats",
    "check:cssvar": "node scripts/css-var-override.check.cjs",
    "check:calendarui": "node scripts/calendar-ui.check.cjs",
    "check:chattabs": "node scripts/chat-multitab.check.cjs",
    "check:newtab": "node scripts/newtab-open.check.cjs",
    "e2e:canvaslive": "node scripts/canvas-live.e2e.cjs",
    "e2e:seams": "node scripts/plugin-seams.e2e.cjs"
