  "research": {
    "version": 1,
    "id": "research",
    "title": "网页信息，变成可读的答案",
    "inputs": [],
    "resources": [
      {
        "id": "react",
        "kind": "source",
        "url": "https://react.dev/learn/preserving-and-resetting-state",
        "title": "React：保留与重置状态",
        "description": "组件类型、位置与 key 影响状态是否保留。长久的用户选择需要独立存储。"
      },
      {
        "id": "streams",
        "kind": "source",
        "url": "https://platform.openai.com/docs/guides/streaming-responses",
        "title": "OpenAI：流式响应",
        "description": "传输层逐步接收事件。界面应以已经验证的完整内容单元提交。"
      }
    ],
    "blocks": [
      {
        "id": "summary",
        "kind": "text",
        "markdown": "两条工程原则：**用户状态独立保存**；**完整区块验证后显示**。下面的来源可以展开摘要，也可打开原文。"
      },
      {
        "id": "sources",
        "kind": "sources",
        "resourceIds": [
          "react",
          "streams"
        ]
      },
      {
        "id": "more",
        "kind": "disclosure",
        "title": "如何用在 Forsion",
        "markdown": "人数与选项在本地更新。模型内容更新时保留用户已操作的值，历史记录继续使用原有工具事件恢复。"
      }
    ]
  },
