<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- enableOnBackInvokedCallback:Android 13+ 预测性返回。@capacitor/app 走 androidx
         OnBackPressedDispatcher(会自动桥接新 API),JS 侧 backButton 链不受影响;
         系统返回预览动画只出现在链底「挂起 app」那一档(MobileRoot.useAndroidBack)。 -->
    <!-- P1-K8:手机作为 Unit 的身份条目(shared_prefs/forsion_unit.xml,Keystore 包裹)不进备份、不随设备迁移:
         API ≤ 30 读 fullBackupContent,31+ 读 dataExtractionRules。钥匙本来也不随备份走,排除是为了不带走一份解不开的死条目。 -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链登录回跳:Forsion /auth 登录成功后 redirect 到 tangu://auth-callback?token=…,
                 由 @capacitor/app 的 appUrlOpen 接收(见 src/capacitorAuth.ts）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tangu" android:host="auth-callback" />
            </intent-filter>

            <!-- 分享到 Forsion:别的 App 的「分享」面板里出现本应用。分享进来先落一张半屏挑去处(新会话 / 最近的会话 /
                 存为笔记);进会话 = 文字接在输入框已有内容后面、文件 / 图片成为附件,不替用户发送。
                 ShareInboxPlugin 接(handleOnNewIntent),页面侧 src/shareInbox.tsx。
                 */* 含 text/plain;附件的个数 / 大小上限与「添加文件」同一套(FilePickPlan)。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- 灵动岛保活:agent 跑着时的前台服务(见 LiveIslandService 顶部注释:为什么非有不可)。 -->
        <service
            android:name=".LiveIslandService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音输入(共享 hook useVoiceInput → WebView 的 getUserMedia):页面要麦克风时,Capacitor 的 BridgeWebChromeClient
         向系统运行时申请这两项,缺任何一项整次请求即被拒。此前清单里没写,只靠 @capacitor/inappbrowser 依赖的清单顺带并进
         安装包(2026-10-05 核过合并清单)—— 升个依赖就可能悄悄没了,所以写明。安装包的权限集合不因此变化。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 聊天「＋」→ 拍照(NativeFilePickerPlugin):照片由系统相机 App 拍(ACTION_IMAGE_CAPTURE),本 App 并不自己开摄像头。
         但合并清单里本来就有 CAMERA(同样是 @capacitor/inappbrowser 顺带并进,2026-10-05 核过),而系统规定:清单声明了
         CAMERA 却没拿到授权的 App,发 ACTION_IMAGE_CAPTURE 直接 SecurityException。所以拍照前先向用户申请这一项,并在这里
         写明(理由同上面的麦克风:不靠依赖顺带)。安装包的权限集合不因此变化。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 灵动岛(LiveIslandPlugin):通知运行时权限(13+)、Live Updates 推广(16+,安装时授予)、run 期间的前台服务。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 手机操控 T1(PhoneControlPlugin):AlarmClock.ACTION_SET_ALARM / SET_TIMER 要求的 normal 级权限(安装即授予)。
         ⚠️ 手机操控刻意不要:无障碍服务、QUERY_ALL_PACKAGES、CALL_PHONE(拨号只用 ACTION_DIAL 填号)。手电筒
         (CameraManager.setTorchMode)也不需要 CAMERA —— 上面那条 CAMERA 是「拍照」用的,与手机操控无关。
         见 Forsion-Genesis/tangu-agent/docs/phone-control.md。 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 手机操控的包可见性(Android 11+):只声明要用的几类 Intent,不申请 QUERY_ALL_PACKAGES。
         LAUNCHER 让「按名字打开 App」与目标 App 的显示名可见;其余让 resolveActivity 能判定接手者(R1/R3 分级)。
         ⚠️ 带 <data> 的过滤器只匹配同样带 data 的查询:DIAL/SENDTO 必须写 scheme,SEND 必须写 mimeType。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- 地图 App 自家的导航 scheme(引擎 tangu-agent/src/tools/builtin/phoneLinks.ts 生成、PhoneVerbs.MAP_SCHEMES 分级)。
             ⚠️ 不写这几条,没被 https/geo 顺带变可见的地图 App 在 11+ 上 resolveActivity 为空:导航候选被当成「没人接」
             跳过,落到 geo 兜底(只落点不出路线)。改 phoneLinks.ts 的 scheme 必须同步这里。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amapuri" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="androidamap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="baidumap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="qqmap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
