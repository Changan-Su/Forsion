          {
            "id": "a",
            "title": "中心构图",
            "description": "视线集中",
            "facts": [
              "适合标题居中",
              "纵深感较强"
            ]
          },
          {
            "id": "b",
            "title": "斜线构图",
            "description": "视线流动",
            "facts": [
              "适合内容导读",
              "保留图像边缘"
            ]
          },
          {
            "id": "c",
            "title": "岸边留白",
            "description": "气氛平静",
            "facts": [
              "适合短文封面",
              "注意文字对比度"
            ]
          }
        ]
      },
      {
        "id": "sources",
        "kind": "sources",
        "title": "图片来源",
        "resourceIds": [
          "origin"
        ]
      }
    ]
